# cp .env.example .env 후 값을 채우세요. .env 는 git 에 올라가지 않습니다.

# ── 한국투자증권 KIS Developers (조회 전용. 이 프로젝트는 주문 API 를 호출하지 않습니다) ──
# env  : 아래 키로 코드가 직접 토큰을 발급 (PC 실행)
# proxy: 키·토큰을 코드가 갖지 않고, 세션의 네트워크 시크릿이 헤더(authorization/appkey/appsecret)를 붙임 (클라우드 세션)
KIS_AUTH_MODE=env
KIS_APP_KEY=
KIS_APP_SECRET=
# prod(실전) | vps(모의). 모의는 초당 호출 제한이 낮아 전 종목 수집에 부적합
KIS_ENV=prod

# ── OpenDART (https://opendart.fss.or.kr) ──
DART_API_KEY=

# ── LLM (조사 Agent) ──
# azure: .env 의 키로 직접 호출 | azure_proxy: 키 없이 세션 네트워크 시크릿이 api-key 헤더를 붙임 | openai
LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 동작 ──
# Agent 최대 도구 호출 스텝
AGENT_MAX_STEPS=6
# API 응답 캐시 디렉터리 (같은 기준일 재실행 시 네트워크 호출 없음)
CACHE_DIR=data/cache
