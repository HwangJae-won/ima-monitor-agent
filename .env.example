# cp .env.example .env 후 값을 채우세요. .env 는 git 에 올라가지 않습니다.

# ── 한국투자증권 KIS Developers (조회 전용. 이 프로젝트는 주문 API 를 호출하지 않습니다) ──
KIS_APP_KEY=
KIS_APP_SECRET=
# prod(실전) | vps(모의). 모의는 초당 호출 제한이 낮아 전 종목 수집에 부적합
KIS_ENV=prod

# ── OpenDART (https://opendart.fss.or.kr) ──
DART_API_KEY=

# ── LLM (조사 Agent). 기본은 Azure OpenAI, openai 로 바꾸면 OpenAI 직접 호출 ──
LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 동작 ──
# Agent 최대 도구 호출 스텝
AGENT_MAX_STEPS=6
# API 응답 캐시 디렉터리 (같은 기준일 재실행 시 네트워크 호출 없음)
CACHE_DIR=data/cache
